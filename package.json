{
  "name": "yaml-studio",
  "private": true,
  "version": "1.3.3",
  "description": "YAML 可视化编辑器 / 测试 / AI 生成 — 桌面版",
  "author": "YAML Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm:dev\" \"npm:electron:wait\"",
    "electron:wait": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "test": "tsx --tsconfig tsconfig.app.json --test tests/*.test.ts tests/*.test.tsx",
    "serve:web": "node scripts/serve-web.cjs",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64",
    "test:web": "node --test tests/server.test.cjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-codemirror": "^4.25.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.69.0",
    "png-to-ico": "^2.1.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.yamlstudio.app",
    "productName": "YAML Studio",
    "copyright": "Copyright © 2026 YAML Studio",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "fileAssociations": [
      {
        "ext": "yaml",
        "name": "YAML 文件",
        "description": "YAML 文档",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "yml",
        "name": "YAML 文件",
        "description": "YAML 文档",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YAML Studio"
    },
    "npmRebuild": false
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.9"
  }
}
